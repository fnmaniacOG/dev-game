# Copy to .env.local and fill in your values

# Solana RPC — use Helius for production (better rate limits + indexing)
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# For mainnet: NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Anthropic API key — used for AI game designer
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — used for off-chain game state indexing and leaderboards
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...  # server-side only

# Helius webhook secret — for validating on-chain event webhooks
HELIUS_WEBHOOK_SECRET=your_webhook_secret

# Program IDs — update after anchor build
NEXT_PUBLIC_TOKEN_FACTORY_PROGRAM_ID=TokFact111111111111111111111111111111111111
NEXT_PUBLIC_LIQUIDITY_LOCK_PROGRAM_ID=LiqLock11111111111111111111111111111111111
NEXT_PUBLIC_GAME_STATE_PROGRAM_ID=GameStat11111111111111111111111111111111111
NEXT_PUBLIC_TOURNAMENT_PROGRAM_ID=Tournam1111111111111111111111111111111111111
NEXT_PUBLIC_VRF_CONSUMER_PROGRAM_ID=VrfCons11111111111111111111111111111111111
NEXT_PUBLIC_GOVERNANCE_PROGRAM_ID=GovTok1111111111111111111111111111111111111

# Switchboard function ID — update after deploying your VRF function
NEXT_PUBLIC_SWITCHBOARD_FUNCTION_ID=SbFunc...

# Health monitor alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
PAGERDUTY_ROUTING_KEY=...
RESEND_API_KEY=re_...
ALERT_EMAIL=ops@devgame.io
